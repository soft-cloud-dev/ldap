dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword by self write by dn.exact="uid=vault,ou=people,{{ LDAP_BASE_DN }}" write by anonymous auth by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by * none
olcAccess: {1}to attrs=shadowLastChange by self write by dn.exact="uid=vault,ou=people,{{ LDAP_BASE_DN }}" write by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by * read
olcAccess: {2}to dn.base="{{ LDAP_BASE_DN }}" by dn.exact="uid=vault,ou=people,{{ LDAP_BASE_DN }}" read by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by * none
olcAccess: {3}to dn.subtree="ou=people,{{ LDAP_BASE_DN }}" by dn.exact="uid=vault,ou=people,{{ LDAP_BASE_DN }}" read by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by * none
olcAccess: {4}to dn.subtree="ou=groups,{{ LDAP_BASE_DN }}" by dn.exact="uid=vault,ou=people,{{ LDAP_BASE_DN }}" read by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by * none
olcAccess: {5}to * by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by * none
